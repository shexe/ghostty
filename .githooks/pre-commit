#!/bin/sh
# Reject staged changes that add a path on this machine or its hostname,
# and a commit whose identity is not the one this repository allows.
#
# Flags added lines containing a home directory path (/Users/<name>/ or
# /home/<name>/), a personal ~/<dir>/ path, or this machine's .local hostname.
# Placeholder names such as /Users/you/ are allowed. The offending value is
# never printed, only the file it is in.

set -eu

# The allowed identity is user.name and user.email in the git config of this
# repository (see .githooks/identity). The committer must be it, and the email
# must be a GitHub noreply address. The author must be it too, unless it is
# another person's (a commit of Ghostty or of another fork, cherry-picked). An
# author with the allowed name and another email is rejected, so no personal
# email goes into the history. A commit that keeps another author (a
# cherry-pick, an amend) is checked again as it is pushed.
. "$(dirname "$0")/identity"
allowed_identity pre-commit
for role in AUTHOR COMMITTER; do
    ident=$(git var "GIT_${role}_IDENT")
    name=${ident%% <*}
    email=$(printf '%s\n' "$ident" | sed -E 's/.*<([^>]*)>.*/\1/')
    own=0
    [ "$name" = "$allowed_name" ] || [ "$email" = "$allowed_email" ] && own=1
    if { [ "$role" = COMMITTER ] || [ "$own" = 1 ]; } &&
        { [ "$name" != "$allowed_name" ] || [ "$email" != "$allowed_email" ]; }; then
        echo "pre-commit: the commit's $(echo "$role" | tr 'A-Z' 'a-z') is not the identity in git config user.name and user.email." >&2
        echo "pre-commit: do not override the identity for one commit (-c user.email, GIT_AUTHOR_EMAIL)." >&2
        exit 1
    fi
done

host="$(scutil --get LocalHostName 2>/dev/null || hostname -s 2>/dev/null || echo '')"

placeholders='example|you|yourname|user|username|name|foo|bar|someone|me'
pattern='/Users/[A-Za-z0-9._-]+/|/home/[A-Za-z0-9._-]+/|~/[A-Za-z0-9][A-Za-z0-9._-]*/'
[ -n "$host" ] && pattern="${pattern}|${host}[.]local"

bad=""
for file in $(git diff --cached --name-only --diff-filter=ACM); do
    if git diff --cached --no-color -U0 -- "$file" |
        grep -E '^\+' | grep -Ev '^\+\+\+' |
        grep -E "$pattern" |
        grep -Evq "/Users/(${placeholders})/|/home/(${placeholders})/"
    then
        bad="$bad $file"
    fi
done
[ -z "$bad" ] && exit 0

echo "pre-commit: these files add a local path or hostname:" >&2
for f in $bad; do printf '  %s\n' "$f" >&2; done
echo "pre-commit: use a portable form (\$HOME, an env var, or a placeholder)." >&2
exit 1
