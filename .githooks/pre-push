#!/bin/sh
# Guard: never push to the original Ghostty repos.
#
# This fork may only ever be pushed to shexe/ghostty. Any attempt
# to push to the original (ghostty-org/ghostty, lemur1905/ghostty-pixel-scroll)
# is refused, regardless of remote name or URL.
#
# $1 = remote name, $2 = remote URL
set -eu

remote_name="$1"
remote_url="$2"
allowed="github.com/shexe/ghostty"

case "$remote_url" in
    *"$allowed" | *"$allowed.git" | *github.com:shexe/ghostty.git)
        ;;
    *)
        echo "pre-push: refusing to push to '$remote_name' ($remote_url)." >&2
        echo "pre-push: this fork may only be pushed to $allowed." >&2
        echo "pre-push: never push to the original Ghostty repositories." >&2
        exit 1
        ;;
esac

case "$remote_url" in
    *ghostty-org/ghostty*|*lemur1905/ghostty*)
        echo "pre-push: refusing to push to the original repository." >&2
        exit 1
        ;;
esac

# Every commit that this push sends, and that no other remote has (Ghostty
# and the other forks), must have the identity in git config user.name and
# user.email as its committer (see .githooks/identity). Its author must be
# that identity too, unless it is another person's. An author or committer
# with the allowed name and another email is rejected, so no personal email
# is published. The commit's SHA is named, not the email it has.
. "$(dirname "$0")/identity"
allowed_identity pre-push
others=$(git for-each-ref --format='%(refname)' refs/remotes | grep -v "^refs/remotes/$remote_name/" || true)
zero=0000000000000000000000000000000000000000
bad=""
while read -r local_ref local_sha remote_ref remote_sha; do
    [ "$local_sha" = "$zero" ] && continue
    if [ "$remote_sha" = "$zero" ] || ! git cat-file -e "$remote_sha^{commit}" 2>/dev/null; then
        range="$local_sha --not --remotes=$remote_name"
    else
        range="$remote_sha..$local_sha --not"
    fi
    # shellcheck disable=SC2086
    bad="$bad$(git log --format='%H%x09%an%x09%ae%x09%cn%x09%ce' $range $others |
        awk -F '\t' -v n="$allowed_name" -v e="$allowed_email" '
            $4 != n || $5 != e { print " " $1; next }
            ($2 == n || $3 == e) && ($2 != n || $3 != e) { print " " $1 }')"
done
if [ -n "$bad" ]; then
    echo "pre-push: these commits have an author or committer other than git config user.name and user.email:" >&2
    for c in $bad; do printf '  %s\n' "$c" >&2; done
    echo "pre-push: rewrite them with that identity, then push again." >&2
    exit 1
fi

exit 0
