#!/bin/sh
# Guard: never push to the original Ghostty repos.
#
# This fork may only ever be pushed to shexe/ghostty. Any attempt
# to push to the original (ghostty-org/ghostty, lemur1905/ghostty-pixel-scroll)
# is refused, regardless of remote name or URL.
#
# $1 = remote name, $2 = remote URL
set -eu

remote_name="$1"
remote_url="$2"
allowed="github.com/shexe/ghostty"

case "$remote_url" in
    *"$allowed" | *"$allowed.git" | *github.com:shexe/ghostty.git)
        ;;
    *)
        echo "pre-push: refusing to push to '$remote_name' ($remote_url)." >&2
        echo "pre-push: this fork may only be pushed to $allowed." >&2
        echo "pre-push: never push to the original Ghostty repositories." >&2
        exit 1
        ;;
esac

case "$remote_url" in
    *ghostty-org/ghostty*|*lemur1905/ghostty*)
        echo "pre-push: refusing to push to the original repository." >&2
        exit 1
        ;;
esac

# Every commit that this push sends with an author or committer named shexe
# must have GitHub's noreply address there, so no personal email is
# published. Upstream authors are not checked. The commit's SHA is named,
# not the email it has.
noreply="$(git config user.email)"
zero=0000000000000000000000000000000000000000
bad=""
while read -r local_ref local_sha remote_ref remote_sha; do
    [ "$local_sha" = "$zero" ] && continue
    if [ "$remote_sha" = "$zero" ]; then
        range="$local_sha --not --remotes=$1"
    else
        range="$remote_sha..$local_sha"
    fi
    # shellcheck disable=SC2086
    bad="$bad$(git log --format='%H%x09%an%x09%ae%x09%cn%x09%ce' $range |
        awk -F '\t' -v a="$noreply" '($2 == "shexe" && $3 != a) || ($4 == "shexe" && $5 != a) { print " " $1 }')"
done
if [ -n "$bad" ]; then
    echo "pre-push: these commits have an author or committer email other than $noreply:" >&2
    for c in $bad; do printf '  %s\n' "$c" >&2; done
    echo "pre-push: rewrite them as shexe <$noreply>, then push again." >&2
    exit 1
fi

exit 0
